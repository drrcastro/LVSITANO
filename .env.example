# --- Obrigatórias ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Canal #notas
DISCORD_CHANNEL_ID=
# Role Villain (requisito)
DISCORD_REQUIRE_ROLE_ID=
# Role Note Reader (atribuído)
DISCORD_ROLE_ID=

# --- Opcionais ---
# Role dos robots para o /status (se vazio, procura um role chamado "Robot")
DISCORD_ROBOT_ROLE_ID=
# Nº de notas mais recentes que contam (0 = todas)
DISCORD_NOTES_LIMIT=100
# true = o autor conta como tendo reagido à própria nota
DISCORD_AUTHOR_AUTO_READ=false
# Aponta para um volume persistente em produção
DB_PATH=message_counts.sqlite3
